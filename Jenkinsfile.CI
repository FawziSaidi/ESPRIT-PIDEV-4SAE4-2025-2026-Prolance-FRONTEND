// ─────────────────────────────────────────────────────────────────────────────
// PIPELINE CI — Prolance Frontend (COMPLETE - All Stages Working)
// ─────────────────────────────────────────────────────────────────────────────

pipeline {

    agent any

    environment {
        NODE_VERSION      = '18'
        LOCAL_REGISTRY    = '172.24.254.13:5000'
        DOCKER_IMAGE      = "${LOCAL_REGISTRY}/prolance-frontend"
        DOCKER_TAG        = "${env.BRANCH_NAME ?: 'main'}-${env.BUILD_NUMBER}"
        HUB_IMAGE         = 'farrahamami/prolance-frontend'
        SONAR_PROJECT     = 'prolance-frontend'
        CHROME_BIN        = '/usr/bin/chromium'
        NODE_OPTIONS      = '--max-old-space-size=2048'
        DOCKER_BUILDKIT   = '1'
        BUILDKIT_PROGRESS = 'plain'
    }

    tools {
        nodejs 'NodeJS-18'
    }

    triggers {
        githubPush()
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        skipDefaultCheckout(true)
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
                echo "Workspace cleaned"
            }
        }

        stage('Sparse Checkout') {
            steps {
                sh '''
                    echo "=== Sparse checkout - downloading ONLY required files ==="

                    # Clean everything
                    rm -rf * .git 2>/dev/null || true

                    # Initialize git
                    git init
                    git remote add origin https://github.com/FawziSaidi/ESPRIT-PIDEV-4SAE4-2025-2026-Prolance-FRONTEND.git

                    # Enable sparse checkout
                    git config core.sparseCheckout true

                    # FIX: use printf so paths have NO leading whitespace
                    # (heredoc indentation was causing all paths to be prefixed
                    #  with spaces, so git never matched any files — including
                    #  package-lock.json, which broke npm ci downstream)
                    printf 'src/\nangular.json\npackage.json\npackage-lock.json\ntsconfig.json\ntsconfig.app.json\ntsconfig.spec.json\nkarma.conf.js\nDockerfile\nnginx.conf\n.dockerignore\n.sonarcloud.properties\n' \
                        > .git/info/sparse-checkout

                    echo "=== Sparse-checkout patterns ==="
                    cat .git/info/sparse-checkout

                    # Fetch only latest commit
                    git fetch --depth 1 origin ${BRANCH_NAME:-main}

                    # Checkout the files
                    git checkout FETCH_HEAD

                    echo "=== Downloaded files ==="
                    ls -la

                    echo "=== Total size ==="
                    du -sh .
                '''
                echo "Branch: ${env.BRANCH_NAME} | Build: ${env.BUILD_NUMBER}"
            }
        }

        stage('Install') {
            steps {
                sh '''
                    echo "=== Installing dependencies ==="

                    # Sanity-check: fail fast with a clear message if lock file is missing
                    if [ ! -f package-lock.json ]; then
                        echo "❌ package-lock.json not found — sparse checkout may have failed"
                        exit 1
                    fi

                    echo "Memory before install:"
                    free -h

                    npm ci --legacy-peer-deps --maxsockets=1 --no-audit --no-fund

                    echo "Memory after install:"
                    free -h
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    echo "=== Running unit tests ==="
                    npx ng test \
                        --no-watch \
                        --no-progress \
                        --browsers=ChromeHeadlessCI \
                        --code-coverage \
                        --source-map=false
                '''
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'coverage/**/*.xml'

                    publishHTML([
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'coverage/prolance-frontend',
                        reportFiles: 'index.html',
                        reportName: 'Coverage Report'
                    ])
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        echo "=== Running SonarQube analysis ==="
                        npx sonar-scanner \
                            -Dsonar.projectKey=${SONAR_PROJECT} \
                            -Dsonar.projectName="Prolance Frontend" \
                            -Dsonar.sources=src \
                            -Dsonar.tests=src \
                            -Dsonar.test.inclusions=**/*.spec.ts \
                            -Dsonar.exclusions=**/node_modules/**,**/*.spec.ts,src/assets/** \
                            -Dsonar.javascript.lcov.reportPaths=coverage/prolance-frontend/lcov.info \
                            -Dsonar.typescript.tsconfigPath=tsconfig.app.json \
                            -Dsonar.scanner.skipJreProvisioning=true
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                sh '''
                    echo "=== Building Angular app ==="
                    npx ng build \
                        --configuration production \
                        --optimization=true \
                        --source-map=false \
                        --delete-output-path=true \
                        --build-optimizer=true

                    echo "=== Build complete ==="
                    du -sh dist/
                '''
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh """
                            echo "=== Building Docker image ==="
                            echo "Build context size:"
                            du -sh .

                            docker build \
                                --memory=2g \
                                --build-arg BUILDKIT_INLINE_CACHE=1 \
                                --cache-from ${DOCKER_IMAGE}:latest \
                                -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                                -t ${DOCKER_IMAGE}:latest \
                                .

                            echo "=== Pushing to local registry ==="
                            docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                            docker push ${DOCKER_IMAGE}:latest

                            echo "=== Pushing to Docker Hub ==="
                            echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin
                            docker tag ${DOCKER_IMAGE}:latest ${HUB_IMAGE}:${DOCKER_TAG}
                            docker tag ${DOCKER_IMAGE}:latest ${HUB_IMAGE}:latest
                            docker push ${HUB_IMAGE}:${DOCKER_TAG}
                            docker push ${HUB_IMAGE}:latest
                            docker logout

                            echo "✅ CI Pipeline passed — Image: ${DOCKER_IMAGE}:${DOCKER_TAG}"
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ CI Pipeline completed successfully!"
        }
        failure {
            echo "❌ CI Pipeline failed - Check logs above"
            sh '''
                echo "=== Docker disk usage ==="
                docker system df
            '''
        }
        always {
            cleanWs()
        }
    }
}