// ─────────────────────────────────────────────────────────────────────────────
// PIPELINE CI — Prolance Frontend (Optimized - No Crashes)
// Triggers on every push to main or develop
// Steps: Checkout → Install → Test → SonarQube → Docker Build → Push
// ─────────────────────────────────────────────────────────────────────────────

pipeline {

    agent any

    environment {
        NODE_VERSION     = '18'
        LOCAL_REGISTRY   = '172.24.254.13:5000'
        DOCKER_IMAGE     = "${LOCAL_REGISTRY}/prolance-frontend"
        DOCKER_TAG       = "${env.BRANCH_NAME ?: 'main'}-${env.BUILD_NUMBER}"
        HUB_IMAGE        = 'farrahamami/prolance-frontend'
        SONAR_PROJECT    = 'prolance-frontend'
        CHROME_BIN       = '/usr/bin/chromium'
        // Memory optimizations
        NODE_OPTIONS     = '--max-old-space-size=2048'
        DOCKER_BUILDKIT  = '1'
        BUILDKIT_PROGRESS = 'plain'
    }

    tools {
        nodejs 'NodeJS-18'
    }

    triggers {
        githubPush()
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        ansiColor('xterm')
    }

    stages {

        stage('Checkout') {
            steps {
                sh '''
                    git config --global http.version HTTP/1.1
                    git config --global http.postBuffer 524288000
                '''

                checkout([
                    $class: 'GitSCM',
                    branches: scm.branches,
                    extensions: [
                        [$class: 'SparseCheckoutPaths', sparseCheckoutPaths: [
                            [path: 'src'],
                            [path: 'angular.json'],
                            [path: 'package.json'],
                            [path: 'package-lock.json'],
                            [path: 'Dockerfile'],
                            [path: 'nginx.conf'],
                            [path: '.dockerignore']
                        ]],
                        [$class: 'CloneOption',
                            shallow : true,
                            depth   : 1,
                            noTags  : true,
                            timeout : 20
                        ]
                    ],
                    userRemoteConfigs: scm.userRemoteConfigs
                ])

                echo "Branch: ${env.BRANCH_NAME} | Build: ${env.BUILD_NUMBER}"
                
                // Verify .dockerignore exists
                sh 'ls -la .dockerignore || echo "WARNING: .dockerignore not found!"'
            }
        }

        stage('Install') {
            steps {
                sh '''
                    echo "=== Memory before install ==="
                    free -h
                    echo "=== Disk space before install ==="
                    df -h
                    
                    # Clean install with memory limit
                    npm ci --legacy-peer-deps --maxsockets=1 --no-audit --no-fund
                    
                    echo "=== Memory after install ==="
                    free -h
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    echo "=== Running tests ==="
                    npx ng test \
                        --no-watch \
                        --no-progress \
                        --browsers=ChromeHeadlessCI \
                        --code-coverage \
                        --source-map=false
                '''
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'coverage/**/*.xml'

                    publishHTML([
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'coverage/prolance-frontend',
                        reportFiles: 'index.html',
                        reportName: 'Coverage Report'
                    ])
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        npx sonar-scanner \
                            -Dsonar.projectKey=${SONAR_PROJECT} \
                            -Dsonar.projectName="Prolance Frontend" \
                            -Dsonar.sources=src \
                            -Dsonar.tests=src \
                            -Dsonar.test.inclusions=**/*.spec.ts \
                            -Dsonar.exclusions=**/node_modules/**,**/*.spec.ts,src/assets/** \
                            -Dsonar.javascript.lcov.reportPaths=coverage/prolance-frontend/lcov.info \
                            -Dsonar.typescript.tsconfigPath=tsconfig.app.json \
                            -Dsonar.scanner.skipJreProvisioning=true
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                sh '''
                    echo "=== Building Angular app ==="
                    free -h
                    
                    npx ng build \
                        --configuration production \
                        --optimization=true \
                        --source-map=false \
                        --delete-output-path=true \
                        --build-optimizer=true
                    
                    echo "=== Build completed. Dist size: ==="
                    du -sh dist/ 2>/dev/null || echo "Dist not found"
                '''
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh """
                            echo "=== Docker Build Context Size ==="
                            du -sh . --exclude=node_modules 2>/dev/null || echo "Cannot calculate"
                            
                            echo "=== Building Docker image ==="
                            # Build with memory limit
                            docker build \
                                --memory=2g \
                                --build-arg BUILDKIT_INLINE_CACHE=1 \
                                --cache-from ${DOCKER_IMAGE}:latest \
                                -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                                -t ${DOCKER_IMAGE}:latest \
                                .

                            echo "=== Image size ==="
                            docker images | grep prolance-frontend | head -2

                            echo "=== Pushing to local registry ==="
                            docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                            docker push ${DOCKER_IMAGE}:latest

                            echo "=== Pushing to Docker Hub as backup ==="
                            echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin
                            docker tag ${DOCKER_IMAGE}:latest ${HUB_IMAGE}:${DOCKER_TAG}
                            docker tag ${DOCKER_IMAGE}:latest ${HUB_IMAGE}:latest
                            docker push ${HUB_IMAGE}:${DOCKER_TAG}
                            docker push ${HUB_IMAGE}:latest
                            docker logout

                            echo "✅ CI Pipeline passed — Image: ${DOCKER_IMAGE}:${DOCKER_TAG}"
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ CI Pipeline passed — Image: ${DOCKER_IMAGE}:${DOCKER_TAG}"
        }
        failure {
            echo "❌ CI Pipeline failed — Check logs above"
            sh '''
                echo "=== Docker disk usage ==="
                docker system df
                echo "=== Last 50 lines of build log ==="
                tail -100 build.log 2>/dev/null || echo "No build log"
            '''
        }
        always {
            // Clean workspace but keep Docker cache
            cleanWs()
        }
    }
}