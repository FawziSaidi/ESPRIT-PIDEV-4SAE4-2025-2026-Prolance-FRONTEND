// ─────────────────────────────────────────────────────────────────────────────
// PIPELINE CI — Prolance Frontend
// Triggers on every push to main or develop
// Steps: Checkout (Sparse) → Install → Test → SonarQube → Docker Build → Push
// ─────────────────────────────────────────────────────────────────────────────

pipeline {

    agent any

    environment {
        NODE_VERSION     = '18'
        DOCKER_IMAGE     = 'farrahamami/prolance-frontend'
        DOCKER_TAG       = "${env.BRANCH_NAME}-${env.BUILD_NUMBER}"
        SONAR_PROJECT    = 'prolance-frontend'
        CHROME_BIN       = '/usr/bin/chromium'
    }

    tools {
        nodejs 'NodeJS-18'   // Must match the name configured in Jenkins → Global Tool Config
    }

    triggers {
        githubPush()         // Fires on every GitHub push (requires GitHub plugin)
    }

    options {
        timeout(time: 40, unit: 'MINUTES')
    }

    stages {

        // ── 1. Checkout (Sparse + Shallow) ───────────────────────────────────
        // FIX: Remplace 'checkout scm' par un sparse checkout pour ne cloner
        //      que les fichiers nécessaires aux tests/coverage et éviter les
        //      timeouts HTTP/2 sur un repo volumineux.
        stage('Checkout') {
            steps {
                // FIX HTTP/2: forcer HTTP/1.1 + augmenter le buffer avant le clone
                sh '''
                    git config --global http.version HTTP/1.1
                    git config --global http.postBuffer 524288000
                '''

                checkout([
                    $class: 'GitSCM',
                    branches: scm.branches,
                    extensions: [
                        // ── Sparse checkout : seulement les dossiers/fichiers utiles ──
                        [$class: 'SparseCheckoutPaths', sparseCheckoutPaths: [
                            [path: 'src'],
                            [path: 'angular.json'],
                            [path: 'karma.conf.js'],
                            [path: 'tsconfig.json'],
                            [path: 'tsconfig.app.json'],
                            [path: 'tsconfig.spec.json'],
                            [path: 'typings.d.ts'],
                            [path: 'package.json'],
                            [path: 'package-lock.json'],
                            [path: 'Dockerfile'],
                            [path: 'nginx.conf'],
                            [path: '.sonarcloud.properties']   // si présent
                        ]],
                        // ── Shallow clone : 1 seul commit, sans tags ──
                        [$class: 'CloneOption',
                            shallow : true,
                            depth   : 1,
                            noTags  : true,
                            timeout : 20
                        ]
                    ],
                    userRemoteConfigs: scm.userRemoteConfigs
                ])

                echo "Branch: ${env.BRANCH_NAME} | Build: ${env.BUILD_NUMBER}"
            }
        }

        // ── 2. Install Dependencies ──────────────────────────────────────────
        stage('Install') {
            steps {
                sh 'npm ci --legacy-peer-deps'
            }
        }

        // ── 3. Unit Tests + Coverage ─────────────────────────────────────────
        stage('Test') {
            steps {
                sh '''
                    npx ng test \
                        --no-watch \
                        --no-progress \
                        --browsers=ChromeHeadlessCI \
                        --code-coverage
                '''
            }
            post {
                always {
                    // Publish JUnit test results
                    junit allowEmptyResults: true,
                          testResults: 'coverage/**/*.xml'

                    // Publish HTML coverage report
                    publishHTML([
                        allowMissing:          false,
                        alwaysLinkToLastBuild: true,
                        keepAll:               true,
                        reportDir:             'coverage/prolance-frontend',
                        reportFiles:           'index.html',
                        reportName:            'Coverage Report'
                    ])
                }
            }
        }

        // ── 4. SonarQube Analysis ────────────────────────────────────────────
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {   // Must match name in Jenkins → Configure System
                    sh '''
                        npx sonar-scanner \
                            -Dsonar.projectKey=${SONAR_PROJECT} \
                            -Dsonar.projectName="Prolance Frontend" \
                            -Dsonar.sources=src \
                            -Dsonar.tests=src \
                            -Dsonar.test.inclusions=**/*.spec.ts \
                            -Dsonar.exclusions=**/node_modules/**,**/*.spec.ts,src/assets/** \
                            -Dsonar.javascript.lcov.reportPaths=coverage/prolance-frontend/lcov.info \
                            -Dsonar.typescript.tsconfigPath=tsconfig.app.json
                    '''
                }
            }
        }

      
        // ── 6. Build Angular App ─────────────────────────────────────────────
        stage('Build') {
            steps {
                sh 'npx ng build --configuration development'
            }
        }

        // ── 7. Docker Build & Push ───────────────────────────────────────────
        stage('Docker Build & Push') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh """
                            echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin

                            docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} .
                            docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest

                            docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                            docker push ${DOCKER_IMAGE}:latest

                            docker logout
                        """
                    }
                }
            }
        }

    }

    post {
        success {
            echo "✅ CI Pipeline passed — Image: ${DOCKER_IMAGE}:${DOCKER_TAG}"
        }
        failure {
            echo "❌ CI Pipeline failed — Check logs above"
        }
        always {
            // FIX: cleanWs() doit être dans un bloc node{} pour avoir accès
            //      au contexte hudson.FilePath (sinon MissingContextVariableException)
            node('') {
                cleanWs()
            }
        }
    }
}