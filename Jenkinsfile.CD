// ─────────────────────────────────────────────────────────────────────────────
// PIPELINE CD — Prolance Frontend
// Triggers automatically after CI pipeline succeeds
// Steps: Pull Image → Deploy with Docker → Health Check → Notify
// ─────────────────────────────────────────────────────────────────────────────

pipeline {

    agent any

    environment {
        DOCKER_IMAGE     = 'farrahamami/prolance-frontend'
        DOCKER_TAG       = 'latest'
        CONTAINER_NAME   = 'prolance-frontend'
        APP_PORT         = '80'
        // Utiliser l'espace de travail Jenkins au lieu de /opt
        DEPLOY_DIR       = "${WORKSPACE}/deploy"
    }

    // Triggered automatically when CI pipeline completes successfully
    triggers {
        upstream(
            upstreamProjects: 'Prolance-Frontend-CI',
            threshold: hudson.model.Result.SUCCESS
        )
    }

    stages {

        // ── 1. Checkout deploy configs ───────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
                echo "Deploying ${DOCKER_IMAGE}:${DOCKER_TAG}"
            }
        }

        // ── 2. Pull latest image from DockerHub ──────────────────
        stage('Pull Docker Image') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh """
                            echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin
                            docker pull ${DOCKER_IMAGE}:${DOCKER_TAG}
                            docker logout
                        """
                    }
                }
            }
        }

        // ── 3. Stop old container ────────────────────────────────
        stage('Stop Old Container') {
            steps {
                sh """
                    docker stop ${CONTAINER_NAME} || true
                    docker rm   ${CONTAINER_NAME} || true
                """
            }
        }

        // ── 4. Deploy with Docker (sans docker-compose) ──────────
        stage('Deploy') {
            steps {
                sh """
                    # Démarrer le nouveau conteneur
                    docker run -d \
                        --name ${CONTAINER_NAME} \
                        -p ${APP_PORT}:80 \
                        --restart unless-stopped \
                        ${DOCKER_IMAGE}:${DOCKER_TAG}
                    
                    echo "✅ Conteneur démarré avec succès"
                """
            }
        }

        // ── 5. Health Check ──────────────────────────────────────
        stage('Health Check') {
            steps {
                script {
                    // Attendre que le conteneur soit prêt
                    retry(6) {
                        sleep(time: 5, unit: 'SECONDS')
                        sh """
                            docker ps | grep ${CONTAINER_NAME} || exit 1
                            curl -f http://localhost:${APP_PORT} || exit 1
                        """
                    }
                    echo "✅ Application is up at http://localhost:${APP_PORT}"
                }
            }
        }

        // ── 6. Clean old Docker images ───────────────────────────
        stage('Cleanup') {
            steps {
                sh 'docker image prune -f'
            }
        }
    }

    post {
        success {
            echo "🚀 Deployment successful — ${DOCKER_IMAGE}:${DOCKER_TAG} is live"
        }
        failure {
            echo "💥 Deployment failed"
        }
        always {
            cleanWs()
        }
    }
}