// ─────────────────────────────────────────────────────────────────────────────
// PIPELINE CD — Prolance Frontend
// ─────────────────────────────────────────────────────────────────────────────

pipeline {

    agent any

    environment {
        DOCKER_IMAGE     = 'farrahamami/prolance-frontend'
        DOCKER_TAG       = 'latest'
        CONTAINER_NAME   = 'prolance-frontend'
        APP_PORT         = '80'
        // L'IP de l'hôte où Docker tourne (votre machine WSL)
        HOST_IP          = '172.24.254.13'  // Même IP que Jenkins
    }

    triggers {
        upstream(
            upstreamProjects: 'Prolance-Frontend-CI',
            threshold: hudson.model.Result.SUCCESS
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "Deploying ${DOCKER_IMAGE}:${DOCKER_TAG}"
            }
        }

        stage('Pull Docker Image') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh """
                            echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin
                            docker pull ${DOCKER_IMAGE}:${DOCKER_TAG}
                            docker logout
                        """
                    }
                }
            }
        }

        stage('Stop Old Container') {
            steps {
                sh """
                    docker stop ${CONTAINER_NAME} || true
                    docker rm   ${CONTAINER_NAME} || true
                """
            }
        }

        stage('Deploy') {
            steps {
                sh """
                    docker run -d \
                        --name ${CONTAINER_NAME} \
                        -p ${APP_PORT}:80 \
                        --restart unless-stopped \
                        ${DOCKER_IMAGE}:${DOCKER_TAG}
                    
                    echo "✅ Conteneur démarré avec succès"
                    
                    # Afficher les logs initiaux
                    sleep 3
                    docker logs ${CONTAINER_NAME} --tail 20 || true
                """
            }
        }

        stage('Health Check') {
            steps {
                script {
                    echo "Vérification de la santé de l'application..."
                    
                    // Attendre plus longtemps et tester correctement
                    retry(15) {
                        sleep(time: 4, unit: 'SECONDS')
                        
                        sh """
                            # Vérifier que le conteneur tourne
                            docker inspect ${CONTAINER_NAME} --format='{{.State.Status}}' | grep -q running || exit 1
                            
                            # Tester via l'IP de l'hôte (depuis Jenkins)
                            curl -f -s -o /dev/null -w "%{http_code}" http://${HOST_IP}:${APP_PORT} | grep -q "200\|301\|302" || exit 1
                        """
                    }
                    
                    echo "✅ Application opérationnelle sur http://${HOST_IP}:${APP_PORT}"
                }
            }
        }

        stage('Cleanup') {
            steps {
                sh 'docker image prune -f'
            }
        }
    }

    post {
        success {
            echo "🚀 Déploiement réussi — ${DOCKER_IMAGE}:${DOCKER_TAG} est en ligne"
            echo "🌐 Application accessible sur : http://${HOST_IP}:${APP_PORT}"
        }
        failure {
            echo "💥 Échec du déploiement"
            sh """
                echo "=== Logs du conteneur ==="
                docker logs ${CONTAINER_NAME} --tail 50 || true
                echo "=== Statut du conteneur ==="
                docker ps -a | grep ${CONTAINER_NAME} || true
            """
        }
        always {
            cleanWs()
        }
    }
}